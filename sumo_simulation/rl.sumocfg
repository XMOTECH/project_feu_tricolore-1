<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuration dédiée à l'entraînement/évaluation du régulateur DQN.
     Différences avec map.sumocfg :
       - demande concentrée sur le carrefour étudié (net_demand.rou.xml) ;
       - pas de transport public ni de polygones (inutiles ici, coûteux) ;
       - sorties pilotées par la ligne de commande. -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="osm.net.xml.gz"/>
        <route-files value="net_demand.rou.xml"/>
    </input>

    <processing>
        <ignore-route-errors value="true"/>
        <time-to-teleport value="-1"/>
    </processing>

    <report>
        <no-warnings value="true"/>
        <no-step-log value="true"/>
        <duration-log.statistics value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value="osm.view.xml"/>
    </gui_only>

</sumoConfiguration>
